# Auth.js secret. Generate a long random value for your local .env.local.
AUTH_SECRET=replace-with-a-long-random-secret

# Public site origin. Keep localhost while developing; update after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional staff demo account. Generate a bcrypt hash; never store a plaintext password here.
DEMO_STAFF_PHONE=0911000001
DEMO_STAFF_NAME=Addis Eats Staff
DEMO_STAFF_PASSWORD_HASH=replace-with-a-bcrypt-hash
